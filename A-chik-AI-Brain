    if st.button("Napbo (Login)"):
        # Admin Login Check
        if email == "kasarasank@gmail.com":
            if password == "Pingrak@2026!Strong":
                st.session_state.role = "Admin"
                st.session_state.logged_in = True
                st.rerun()
            else:
