# --- ADMIN PANEL (Pingrak's Control Room) ---
def admin_panel():
    st.title("👑 Nokgipani Niam Ka·ram (Pingrak G Momin)")
    st.success("Rimchaksoa Skigipa Pingrak! AI-na skiani somoi ong·jok.")
    
    st.subheader("📚 AI-na Skibo (Upload PDF or Book)")
    uploaded_file = st.file_uploader("A·chik Ki·tap ba PDF-ko gatbo (Upload here):", type=["pdf", "txt", "csv"])
    
    if uploaded_file is not None:
        st.info(f"Ki·tap '{uploaded_file.name}' nambee gatmanaha! AI da·o poraienga...")
        
    st.subheader("⚡ Gital Katta on·dapani (Manual Data Entry)")
    col1, col2 = st.columns(2)
    with col1:
        new_garo_word = st.text_input("Gital A·chik Katta (New Garo Word):")
    with col2:
        new_meaning = st.text_input("Uni Orto (Meaning in English/Hindi):")
        
    if st.button("AI-na Skibo (Update Brain)"):
        if new_garo_word and new_meaning:
            st.session_state.garo_knowledge[new_garo_word] = new_meaning
            st.success(f"Gital katta '{new_garo_word}' AI-ni taningo donmanaha! (Saved Offline)")
    
    if st.button("Ong·katbo (Logout)"):
        st.session_state.logged_in = False
        st.rerun()

# --- USER PANEL (Garo AI Chat for Public) ---
def user_panel():
    st.title("🤖 A·chik AI Assistant")
    st.write("Salam! Anga Pingrak-ni tariaha A·chik AI ong·a. Na·a maiko u·ina ska, sing·bo!")
    
    user_query = st.text_input("A·chik kattako sebo (Jekai: Nok, Chii, Sal):")
    
    if st.button("Aganchakbo (Search)"):
        if user_query in st.session_state.garo_knowledge:
            st.success(f"🧠 AI Aganchakani: '{user_query}' ni ortoara '{st.session_state.garo_knowledge[user_query]}' ong·a! Nambatgipa sing·ani.")
        else:
            st.warning("Kema ka·bo, angni skigipa (Pingrak) angna iani gimin skikuja. Angni ki·tapo iani gimin dongja. (Admin isey jaldi update karenge!)")
            
    if st.button("Ong·katbo (Logout)"):
        st.session_state.logged_in = False
        st.rerun()

# --- MAIN APP LOGIC ---
def main():
    if "logged_in" not in st.session_state:
        st.session_state.logged_in = False

    if not st.session_state.logged_in:
        login_page()
    else:
        if st.session_state.role == "Admin":
            admin_panel()
        else:
            user_panel()

if __name__ == "__main__":
    main()
